---
// AAPS Atlas search home — static shell rendered by Astro. All interactivity
// (index load, search, type/device/Android filters, cards) is the unchanged
// vanilla JS in public/search.js, which expects exactly the element ids and
// chip/data-attribute structure below. The prebuilt index
// (public/search-index.json, produced by scripts/build_index.py before the
// build) is fetched at runtime; file:// opens inject public/search-data.js.
//
// Populated landing (DA-201): with no query the page is NOT a blank shell —
// Astro statically renders example queries, doc-guide links and a small set
// of top distilled records (complete S->C->F only, computed at build time
// from data/distilled joined to data/corpus comment counts), plus a
// browse-all entry. search.js only toggles this section's visibility and
// implements browse mode + the "include incomplete" toggle.
import Base from '../layouts/Base.astro';
import { loadTopDistilled } from '../lib/top';

// Every example is verified to return hits by scripts/search_check.mjs
// (docs + threads, distilled included) before it may be listed here.
const EXAMPLES = ['G7 broadcast', 'pod activation', 'Android 16 bluetooth', 'sensor restart'];

const GUIDES = [
  { href: '/docs/dexcom-g7.html', title: 'Dexcom G7', src: 'AAPS wiki' },
  { href: '/docs/omnipod-dash.html', title: 'Omnipod DASH', src: 'AAPS wiki' },
  { href: '/docs/xdrip-app.html', title: 'xDrip settings', src: 'AAPS wiki' },
  { href: '/docs/building-aaps.html', title: 'Building AAPS', src: 'AAPS wiki' },
  { href: '/docs/browser-build.html', title: 'Browser build', src: 'AAPS wiki' },
  { href: '/docs/xdrip-g7.html', title: 'xDrip + G7 / Stelo', src: 'xDrip docs' },
];

const topDistilled = loadTopDistilled();
---

<Base title="AAPS Atlas — searchable AAPS / xDrip knowledge base">
  <div class="glow"></div>

  <header class="top">
    <div class="wrap">
      <div class="brand">
        <div class="logo">A</div>
        <div>
          <h1>AAPS&nbsp;Atlas</h1>
          <p class="tag">searchable AAPS / xDrip knowledge — official docs mirror + solved GitHub threads</p>
        </div>
      </div>
      <div class="statline" id="statline">loading corpus…</div>
    </div>
  </header>

  <div class="banner" role="note">
    <strong>Not medical advice.</strong> Content mirrors community documentation and resolved GitHub issue
    discussions (AAPS &amp; xDrip), plus <strong>AI-extracted</strong> symptom → cause → fix records distilled from
    those threads — every distilled record is labelled, carries a verbatim evidence quote, and links back to its
    source issue. Always confirm any change with the official docs, your clinician and your regional regulations
    before acting on it.
  </div>

  <main class="wrap">
    <section class="searchbox">
      <label class="visually-hidden" for="q">Search AAPS Atlas</label>
      <input
        id="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. G7 broadcast · pod activation · Android 16 bluetooth"
        aria-label="Search the knowledge base"
      />
      <div class="meta" id="meta"></div>
    </section>

    <nav class="filters" id="filters" aria-label="Result type filter">
      <button class="chip on" data-type="all">All</button>
      <button class="chip" data-type="docs">Docs</button>
      <button class="chip" data-type="thread">Threads</button>
      <button class="chip" data-type="distilled">Distilled</button>
    </nav>

    <div class="filters" id="devfilters" style="display:none" aria-label="Device filter"></div>
    <div class="filters" id="andfilters" style="display:none" aria-label="Android version filter"></div>

    <!-- conclusions-only toggle: surfaced by search.js only when the current
         view hides incomplete distilled records (see public/search.js). -->
    <div id="incwrap" class="incwrap" hidden>
      <button id="incbtn" type="button" class="chip" aria-pressed="false">
        include incomplete (<span id="incn">0</span>)
      </button>
    </div>

    <!-- Populated landing state (no query): static, rendered by Astro. -->
    <section id="landing" class="landing" aria-label="Explore AAPS Atlas">
      <section class="land-block land-explore">
        <h2 class="landh">Explore</h2>
        <p class="land-sub">Example searches that return results — click one to run it.</p>
        <div class="exgrid">
          {EXAMPLES.map((ex) => (
            <a class="chip ex" href="#q" data-example={ex}>{ex}</a>
          ))}
        </div>
        <p class="land-sub land-sub-gap">Local mirrors of the official setup guides:</p>
        <ul class="guides">
          {GUIDES.map((g) => (
            <li>
              <a class="guide" href={g.href}>
                <span class="guide-title">{g.title}</span>
                <span class="guide-src">{g.src}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="land-block">
        <h2 class="landh">Top distilled records</h2>
        <p class="land-sub">
          Complete symptom → cause → fix extracts (all three parts) from the most-discussed, highest-confidence
          solved threads.
        </p>
        <ol class="results">
          {topDistilled.map((r) => (
            <li class="card toprec">
              <h2>
                <span class="badge distilled">distilled</span>
                <span class="badge gh">GitHub</span>
                <a href={r.url} target="_blank" rel="noopener">{r.title}</a>
              </h2>
              <div class="dbody">
                <p class="kv"><span class="k">Symptom</span>{r.symptom}</p>
                <p class="kv"><span class="k">Cause</span>{r.cause}</p>
                <p class="kv"><span class="k">Fix</span>{r.fix}</p>
              </div>
              <div class="footrow">
                <span class:list={['conf', `conf-${r.confidence}`]}>confidence: {r.confidence}</span>
                <span class="tagchip">{r.issueRef}</span>
                <a class="goto" href={r.url} target="_blank" rel="noopener">view source thread ↗</a>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <div class="browse-row">
        <p class="land-sub">Or browse the whole index at once — distilled first, then threads and docs.</p>
        <button id="browseall" type="button" class="chip browseall">Browse all records ↓</button>
      </div>
    </section>

    <ol id="results" class="results"></ol>
    <div id="status" class="status" role="status"></div>
    <div id="morewrap" class="morewrap" hidden></div>
  </main>

  <footer class="foot">
    <div class="wrap">
      <p>AAPS Atlas — AAPS / xDrip knowledge base. Mirrors: <a href="https://wiki.aaps.app">AndroidAPS wiki</a> ·
        <a href="https://navid200.github.io/xDrip/">xDrip docs</a>. Threads: closed discussions from
        <a href="https://github.com/nightscout/AndroidAPS">nightscout/AndroidAPS</a> and
        <a href="https://github.com/NightscoutFoundation/xDrip">NightscoutFoundation/xDrip</a>,
        each linked back to its original issue. Distilled records are AI-extracted from those threads
        (symptom → cause → fix) and are labelled as such.
        Sources are <em>not</em> medical advice; see banner. Rebuild: <code>npm run build</code>.
      </p>
    </div>
  </footer>

  <script is:inline src="/search.js" defer></script>
</Base>
