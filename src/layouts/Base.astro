---
// AAPS Atlas shared page shell — spoolindex-family dark chrome.
// Kept deliberately light: stylesheet + favicon are static assets copied from
// public/ so the site's look and file paths stay byte-identical to before.
interface Props {
  title: string;
  description?: string;
  /** body class, e.g. "docpage" for the minimal doc mirror pages. */
  bodyClass?: string;
}
const { title, description, bodyClass } = Astro.props;
const desc =
  description ??
  'Client-side search over AAPS / xDrip docs, solved GitHub issue threads, and distilled symptom-cause-fix records. Community knowledge, not medical advice.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23070b0d'/%3E%3Ctext x='16' y='22' font-family='ui-monospace,Menlo,monospace' font-size='16' fill='%234fd1c5' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class:list={[bodyClass]}>
    <slot />
  </body>
</html>
