# Python
__pycache__/
*.pyc

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
node_modules/

# Astro build cache (generated types + internal state)
.astro/

# Generated search-index intermediates (written by scripts/build_index.py into
# public/ before the Astro build; Astro copies them to the site/ output, which
# is what gets committed/deployed).
public/search-index.json
public/search-data.js

# Local build scratch
.tmp/

# Corpus machine-local state (resumable fetch cursor + fetch log). The
# committed deterministic corpus is data/corpus/*.json (per-thread records +
# manifest.json); data/corpus/raw/*.jsonl is the full raw API archive —
# regenerable with scripts/fetch_corpus.py and too heavy to commit.
data/corpus/state.json
data/corpus/raw/
data/corpus/.fetch.log

# FB-corpus privacy: raw Apify archives + author-name rosters are transient
# ingest inputs and must never be committed (only anonymized records live in
# data/fb_threads/*.json).
data/fb_threads/raw/
