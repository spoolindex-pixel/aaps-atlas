{
  "name": "aaps-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "AAPS Atlas — static Astro build of the searchable AAPS / xDrip knowledge base (site/ output is deployed to Cloudflare Pages)",
  "scripts": {
    "build:index": "python3 scripts/build_index.py",
    "astro": "astro build",
    "astro:check": "astro check",
    "build": "npm run build:index && astro build",
    "check": "python3 scripts/validate_distilled.py && node scripts/search_check.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.1",
    "typescript": "6.0.2"
  }
}
